{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Lost Odyssey Recomp",
  "repo": "freefrank/LostOdysseyRecomp",
  "start": {
    "program": ["LostOdysseyRecomp.exe"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {"path": "{install}/settings.ini"}
      ]
    }
  ],
  "settings": [
    {
      "id": "backend",
      "label": "Graphics backend",
      "choices": [
        {"label": "Vulkan", "set": {"graphics_backend": "1"}},
        {"label": "DirectX 12", "set": {"graphics_backend": "0"}}
      ],
      "defaults": {"graphics_backend": "1"},
      "help": "Applied on the next start. XeSS requires DirectX 12; providers still require compatible hardware and drivers."
    },
    {
      "id": "window",
      "label": "Window mode",
      "help": "Borderless fills your screen and still switches apps quickly.",
      "choices": [
        {"label": "Windowed", "set": {"window_mode": "0"}},
        {"label": "Borderless", "set": {"window_mode": "1"}}
      ],
      "defaults": {"window_mode": "0"}
    },
    {
      "id": "aspect",
      "label": "Screen shape",
      "help": "Auto fits your window; a fixed shape frames the picture and the movies with black bars.",
      "choices": [
        {"label": "Auto", "set": {"aspect_ratio": "0"}},
        {"label": "16:9", "set": {"aspect_ratio": "1"}},
        {"label": "21:9", "set": {"aspect_ratio": "2"}},
        {"label": "4:3", "set": {"aspect_ratio": "3"}}
      ],
      "defaults": {"aspect_ratio": "0"}
    },
    {
      "id": "output_resolution",
      "label": "Output resolution",
      "choices": [
        {"label": "1280 × 720", "set": {"width": "1280", "height": "720"}},
        {"label": "1920 × 1080", "set": {"width": "1920", "height": "1080"}},
        {"label": "2560 × 1440", "set": {"width": "2560", "height": "1440"}},
        {"label": "3840 × 2160", "set": {"width": "3840", "height": "2160"}}
      ],
      "defaults": {"width": "1280", "height": "720"},
      "help": "Common window sizes. Fullscreen follows the display; choose unusual display modes in the game."
    },
    {
      "id": "resolution",
      "label": "Internal resolution",
      "help": "What the game draws at before it is fitted to your window. 720p is the console's own.",
      "choices": [
        {"label": "720p (console)", "set": {"internal_resolution": "720"}},
        {"label": "1080p", "set": {"internal_resolution": "1080"}},
        {"label": "1440p", "set": {"internal_resolution": "1440"}},
        {"label": "4K", "set": {"internal_resolution": "2160"}},
        {"label": "Match the window", "set": {"internal_resolution": "0"}}
      ],
      "defaults": {"internal_resolution": "720"}
    },
    {
      "id": "shadow_resolution",
      "label": "Shadow resolution",
      "choices": [
        {"label": "1×", "set": {"shadow_resolution": "1"}},
        {"label": "2×", "set": {"shadow_resolution": "2"}},
        {"label": "4×", "set": {"shadow_resolution": "4"}}
      ],
      "defaults": {"shadow_resolution": "1"}
    },
    {
      "id": "dynamic_shadows",
      "label": "Dynamic shadows",
      "choices": [
        {"label": "On", "set": {"dynamic_shadows": "1"}},
        {"label": "Low", "set": {"dynamic_shadows": "2"}},
        {"label": "Off", "set": {"dynamic_shadows": "0"}}
      ],
      "defaults": {"dynamic_shadows": "1"}
    },
    {
      "id": "antialiasing",
      "label": "Anti-aliasing and upscaling",
      "choices": [
        {"label": "Off", "set": {"upscaler": "0", "antialiasing": "0"}},
        {"label": "FXAA", "set": {"upscaler": "0", "antialiasing": "1"}},
        {"label": "SMAA", "set": {"upscaler": "0", "antialiasing": "2"}},
        {"label": "TAA (experimental)", "set": {"upscaler": "0", "antialiasing": "3"}},
        {"label": "DLSS", "set": {"upscaler": "1"}},
        {"label": "FSR", "set": {"upscaler": "2"}},
        {"label": "XeSS (select DirectX 12 first)", "set": {"upscaler": "4"}}
      ],
      "defaults": {"upscaler": "0", "antialiasing": "0"},
      "help": "Temporal upscaling replaces ordinary anti-aliasing where supported. DLSS needs a compatible NVIDIA RTX GPU; XeSS needs DirectX 12. Unsupported requests fall back to ordinary anti-aliasing."
    },
    {
      "id": "dlss_quality",
      "label": "DLSS quality",
      "choices": [
        {"label": "Quality", "set": {"dlss_quality": "0"}},
        {"label": "Balanced", "set": {"dlss_quality": "1"}},
        {"label": "Performance", "set": {"dlss_quality": "2"}},
        {"label": "DLAA", "set": {"dlss_quality": "3"}}
      ],
      "defaults": {"dlss_quality": "0"},
      "when": {"upscaler": "1"}
    },
    {
      "id": "fsr_quality",
      "label": "FSR quality",
      "choices": [
        {"label": "Quality", "set": {"fsr_quality": "0"}},
        {"label": "Balanced", "set": {"fsr_quality": "1"}},
        {"label": "Performance", "set": {"fsr_quality": "2"}},
        {"label": "Native AA", "set": {"fsr_quality": "3"}}
      ],
      "defaults": {"fsr_quality": "0"},
      "when": {"upscaler": "2"}
    },
    {
      "id": "xess_quality",
      "label": "XeSS quality",
      "choices": [
        {"label": "Quality", "set": {"fsr_quality": "0"}},
        {"label": "Balanced", "set": {"fsr_quality": "1"}},
        {"label": "Performance", "set": {"fsr_quality": "2"}},
        {"label": "Native AA", "set": {"fsr_quality": "3"}}
      ],
      "defaults": {"fsr_quality": "0"},
      "when": {"upscaler": "4"}
    },
    {
      "id": "dlss_model",
      "label": "DLSS model",
      "choices": [
        {"label": "M", "set": {"dlss_model": "0"}},
        {"label": "L", "set": {"dlss_model": "1"}}
      ],
      "defaults": {"dlss_model": "0"},
      "when": {"upscaler": "1"}
    },
    {
      "id": "fsr_sharpness",
