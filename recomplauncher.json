        {"label": "Off", "set": {"dlss_neural_rendering": "0"}},
        {"label": "1", "set": {"dlss_neural_rendering": "1"}},
        {"label": "2", "set": {"dlss_neural_rendering": "2"}},
        {"label": "3", "set": {"dlss_neural_rendering": "3"}},
        {"label": "4", "set": {"dlss_neural_rendering": "4"}}
