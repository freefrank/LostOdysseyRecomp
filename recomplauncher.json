      "choices": [
        {"label": "0%", "set": {"fsr_sharpness": "0"}},
        {"label": "5%", "set": {"fsr_sharpness": "5"}},
        {"label": "10%", "set": {"fsr_sharpness": "10"}},
        {"label": "15%", "set": {"fsr_sharpness": "15"}},
        {"label": "20%", "set": {"fsr_sharpness": "20"}},
        {"label": "25%", "set": {"fsr_sharpness": "25"}},
        {"label": "30%", "set": {"fsr_sharpness": "30"}},
        {"label": "35%", "set": {"fsr_sharpness": "35"}},
        {"label": "40%", "set": {"fsr_sharpness": "40"}},
        {"label": "45%", "set": {"fsr_sharpness": "45"}},
        {"label": "50%", "set": {"fsr_sharpness": "50"}},
        {"label": "55%", "set": {"fsr_sharpness": "55"}},
        {"label": "60%", "set": {"fsr_sharpness": "60"}},
        {"label": "65%", "set": {"fsr_sharpness": "65"}},
        {"label": "70%", "set": {"fsr_sharpness": "70"}},
        {"label": "75%", "set": {"fsr_sharpness": "75"}},
        {"label": "80%", "set": {"fsr_sharpness": "80"}},
        {"label": "85%", "set": {"fsr_sharpness": "85"}},
        {"label": "90%", "set": {"fsr_sharpness": "90"}},
        {"label": "95%", "set": {"fsr_sharpness": "95"}},
        {"label": "100%", "set": {"fsr_sharpness": "100"}}
      ],
      "defaults": {"fsr_sharpness": "0"},
      "when": {"upscaler": "2"}
