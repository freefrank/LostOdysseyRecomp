+// LostOdysseyRecomp: with argument_as_local, r1, r3-r10 and f1-f13 are locals that cache ctx (vectors stay in ctx:
+// storing up to 14 of them before every call could cost more than it saves). They start from
+// ctx (the declarations), what the function writes goes back before every call and return, and everything goes back
+// to the local after a call, so callers, callees and host code see ctx as they always did.
+void Recompiler::CacheArgumentRegisters(std::string& body, const RecompilerLocalVariables& locals)
+{
+    std::string store, load;
+    const auto add = [&](const std::string& name)
+    {
+        // Written: an assignment starts its line; a hook takes the register by reference (no field after the name).
+        const bool written = body.find("\t" + name + ".") != std::string::npos ||
+            body.find("(" + name + ",") != std::string::npos || body.find("(" + name + ")") != std::string::npos ||
+            body.find(", " + name + ",") != std::string::npos || body.find(", " + name + ")") != std::string::npos;
+        if (written)
+            store += fmt::format("\tctx.{0} = {0};\n", name);
+        load += fmt::format("\t{0} = ctx.{0};\n", name);
+    };
+    for (size_t i = 1; i <= 10; i++)
+        if (i != 2 && locals.r[i])
+            add(fmt::format("r{}", i));
+    for (size_t i = 1; i <= 13; i++)
+        if (locals.f[i])
+            add(fmt::format("f{}", i));
+
+    std::string result;
+    result.reserve(body.size() + body.size() / 4);
+    for (size_t at = 0; at < body.size();)
+    {
+        size_t end = body.find('\n', at);
+        end = end == std::string::npos ? body.size() : end + 1;
+        const std::string_view line(body.data() + at, end - at);
+        at = end;
+        const size_t first = line.find_first_not_of(" \t");
+        const std::string_view text = first == std::string_view::npos ? std::string_view{} : line.substr(first);
+        const bool comment = text.rfind("//", 0) == 0;
+        const bool call = !comment && (text.find("(ctx, base);") != std::string_view::npos ||
+            text.rfind("PPC_CALL_INDIRECT_FUNC(", 0) == 0);
+        const size_t returns = comment ? std::string_view::npos : text.rfind("return;");
+        if (call)
+        {
+            result += store;
+            result += line;
+            result += load;
+        }
+        else if (returns == 0)
+        {
+            result += store;
+            result += line;
+        }
+        else if (returns != std::string_view::npos && text.rfind("if (", 0) == 0)
+        {
+            // "if (c) return;"
+            result += line.substr(0, first);
+            result += text.substr(0, returns);
+            result += "{\n";
+            result += store;
+            result += "\treturn;\n\t}\n";
+        }
+        else
+            result += line;
+    }
+    body = std::move(result);
+}
+
+// LostOdysseyRecomp: fast_memory turns PPC_LOAD_*/PPC_STORE_* into their non-volatile forms, except in a loop that
+// loads memory with no store, call or fence: that is a wait on another thread, and without volatile the compiler
+// could move the load out of the loop and never see the value change.
+void Recompiler::UseFastMemory(std::string& body)
+{
+    std::vector<std::string_view> lines;
+    for (size_t at = 0; at < body.size();)
+    {
+        size_t end = body.find('\n', at);
+        end = end == std::string::npos ? body.size() : end + 1;
+        lines.emplace_back(body.data() + at, end - at);
+        at = end;
+    }
+    std::unordered_map<std::string, size_t> labels;
+    for (size_t i = 0; i < lines.size(); i++)
+        if (lines[i].rfind("loc_", 0) == 0)
+            labels.emplace(std::string(lines[i].substr(0, lines[i].find(':'))), i);
+
+    std::vector<bool> keep(lines.size(), false);
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        const size_t go = lines[i].find("goto loc_");
+        if (go == std::string_view::npos)
+            continue;
+        const std::string_view rest = lines[i].substr(go + 5);
+        const auto label = labels.find(std::string(rest.substr(0, rest.find(';'))));
+        if (label == labels.end() || label->second > i)
+            continue;
+        bool waits = true;
+        for (size_t j = label->second; j <= i && waits; j++)
+        {
+            const std::string_view line = lines[j];
+            if (line.find("// ") != std::string_view::npos && line.find_first_not_of('\t') == line.find("// "))
+                continue;
+            if (line.find("_STORE") != std::string_view::npos || line.find("(ctx, base);") != std::string_view::npos ||
+                line.find("PPC_CALL_INDIRECT_FUNC") != std::string_view::npos || line.find("atomic_thread_fence") != std::string_view::npos)
+                waits = false;
+        }
+        if (waits)
+            for (size_t j = label->second; j <= i; j++)
+                keep[j] = true;
+    }
+
+    std::string result;
+    result.reserve(body.size() + body.size() / 8);
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        std::string line(lines[i]);
+        if (!keep[i])
+            for (const char* name : { "PPC_LOAD_U", "PPC_STORE_U" })
+            {
+                const std::string fast = std::string("PPC_FAST_") + (name + 4);
+                for (size_t at = line.find(name); at != std::string::npos; at = line.find(name, at + fast.size()))
+                    line.replace(at, strlen(name), fast);
+            }
+        result += line;
+    }
+    body = std::move(result);
+}
