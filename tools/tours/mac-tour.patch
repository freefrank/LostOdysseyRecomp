diff --git a/LostOdysseyRecomp/debug/battle_tour.cpp b/LostOdysseyRecomp/debug/battle_tour.cpp
new file mode 100644
index 00000000..6b8d15be
--- /dev/null
+++ b/LostOdysseyRecomp/debug/battle_tour.cpp
@@ -0,0 +1,121 @@
+#include <stdafx.h>
+#include <os/logger.h>
+#include "battle_tour.h"
+#include "battle_menu.h"
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+
+namespace
+{
+// Formation table: TArray (data, count) at 0x83264978 + 128 with 160-byte
+// entries; RequestBattle 0x828278A0 indexes it with the formation id. The
+// first field is the battle stage FString; when it is empty the stage is the
+// loader's area stage (0x832631F0 + 1604), then u10_b3_scrw.
+constexpr uint32_t FormationArray = 0x83264978 + 128;
+constexpr uint32_t FormationBytes = 160;
+constexpr uint32_t AreaStage = 0x832631F0 + 1604;
+std::atomic<int32_t> pending{-1};
+
+bool Address(uint32_t p) { return p >= 0x100000 && p < 0xC0000000 && (p & 1) == 0; }
+
+std::string ReadFString(uint8_t* base, uint32_t fstring)
+{
+    const uint32_t data = PPC_LOAD_U32(fstring);
+    const uint32_t count = PPC_LOAD_U32(fstring + 4);
+    std::string text;
+    if (!Address(data) || count < 2 || count > 64) return text;
+    for (uint32_t i = 0; i + 1 < count; ++i)
+    {
+        const uint16_t c = PPC_LOAD_U16(data + i * 2);
+        text += c >= 0x20 && c < 0x7F ? char(c) : '?';
+    }
+    return text;
+}
+
+uint32_t FormationCount(uint8_t* base)
+{
+    const uint32_t count = PPC_LOAD_U32(FormationArray + 4);
+    return Address(PPC_LOAD_U32(FormationArray)) && count < 4096 ? count : 0;
+}
+
+void List(uint8_t* base)
+{
+    const uint32_t data = PPC_LOAD_U32(FormationArray);
+    const uint32_t count = FormationCount(base);
+    LOG_INFO("battle tour: formations={} area_stage={}", count, ReadFString(base, AreaStage));
+    std::string owner;
+    for (uint32_t offset = 0; offset < 0x200; offset += 4)
+        if (const uint32_t word = PPC_LOAD_U32(FormationArray - 128 + offset))
+            owner += fmt::format(" +{}:{:08x}", offset, word);
+    LOG_INFO("battle tour: table owner{}", owner);
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        const uint32_t entry = data + i * FormationBytes;
+        std::string fields;
+        for (uint32_t offset = 0; offset < FormationBytes; offset += 4)
+        {
+            // FString fields (data, count, capacity) print as text, the rest as words.
+            if (offset + 12 <= FormationBytes && PPC_LOAD_U32(entry + offset + 4) > 1 &&
+                PPC_LOAD_U32(entry + offset + 4) == PPC_LOAD_U32(entry + offset + 8) &&
+                !ReadFString(base, entry + offset).empty())
+            {
+                fields += fmt::format(" +{}={}", offset, ReadFString(base, entry + offset));
+                offset += 8;
+            }
+            else if (const uint32_t word = PPC_LOAD_U32(entry + offset))
+                fields += fmt::format(" +{}:{:08x}", offset, word);
+        }
+        // +148/+152: the enemy slot array (data, count).
+        const uint32_t slots = PPC_LOAD_U32(entry + 148);
+        if (Address(slots) && PPC_LOAD_U32(entry + 152) < 64)
+        {
+            fields += " slots:";
+            for (uint32_t offset = 0; offset < 192; offset += 4)
+                fields += fmt::format(" {:08x}", PPC_LOAD_U32(slots + offset));
+        }
+        LOG_INFO("battle tour: formation {}{}", i, fields);
+    }
+}
+}
+
+void debug_menu::battle_tour::Poll(uint8_t* base)
+{
+    static const char* path = std::getenv("LO_DEBUG_BATTLE_FILE");
+    if (!path) return;
+    static std::chrono::steady_clock::time_point next{};
+    static uint64_t last = 0;
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next) return;
+    next = now + std::chrono::milliseconds(250);
+    std::ifstream input(path);
+    uint64_t serial = 0;
+    std::string operation;
+    if (!(input >> serial >> operation) || serial <= last) return;
+    last = serial;
+    int32_t id = -1;
+    if (operation == "list")
+        List(base);
+    else if (operation == "victory")
+        LOG_INFO("battle tour: victory requested={}", debug_menu::RequestVictory());
+    else if (operation == "battle" && input >> id && id >= 0 && uint32_t(id) < FormationCount(base))
+    {
+        pending = id;
+        LOG_INFO("battle tour: formation {} queued", id);
+    }
+    else
+        LOG_INFO("battle tour: rejected command serial={} {} {}", serial, operation, id);
+}
+
+bool debug_menu::battle_tour::Pending()
+{
+    return pending.load(std::memory_order_relaxed) >= 0;
+}
+
+bool debug_menu::battle_tour::Take(int32_t& formation)
+{
+    formation = pending.exchange(-1);
+    return formation >= 0;
+}
diff --git a/LostOdysseyRecomp/debug/battle_tour.h b/LostOdysseyRecomp/debug/battle_tour.h
new file mode 100644
index 00000000..a5bbb797
--- /dev/null
+++ b/LostOdysseyRecomp/debug/battle_tour.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <cstdint>
+
+// Harness hook for recording pipeline recipes battle by battle.
+// LO_DEBUG_BATTLE_FILE holds one command, "serial battle <formation>",
+// "serial victory" (the debug menu's Victory) or "serial list"; a higher
+// serial runs it. The formation starts through the
+// game's own walking-encounter path (see no_encounters.cpp), so it needs a
+// controllable player in the field.
+namespace debug_menu::battle_tour
+{
+    // Engine tick (guest game thread).
+    void Poll(uint8_t* base);
+    // Walking encounter hooks (guest game thread).
+    bool Pending();
+    bool Take(int32_t& formation);
+}
diff --git a/LostOdysseyRecomp/debug/diag_tour.cpp b/LostOdysseyRecomp/debug/diag_tour.cpp
new file mode 100644
index 00000000..703cbe5c
--- /dev/null
+++ b/LostOdysseyRecomp/debug/diag_tour.cpp
@@ -0,0 +1,168 @@
+// DIAGNOSTIC ONLY (never commit): map jump, disc request and package probe
+// command files for the recipe tours, ported from the 2026-10-01 map tour
+// patch (out/map-tour-20261001/diag-tour-and-hitcam.patch).
+#include <stdafx.h>
+#include <kernel/heap.h>
+#include <kernel/memory.h>
+#include <os/logger.h>
+#include <chrono>
+#include <fstream>
+#include <string>
+
+extern "C" PPC_FUNC(__imp__sub_82827580);
+extern "C" PPC_FUNC(__imp__sub_82320428);
+PPC_FUNC(sub_82821E90);
+PPC_FUNC(sub_82298938);
+
+namespace
+{
+bool ObjectAddress(uint32_t p) { return p >= 0x100000 && p < 0x7C000000 && (p & 3) == 0; }
+
+bool Due(std::chrono::steady_clock::time_point& next)
+{
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next) return false;
+    next = now + std::chrono::milliseconds(250);
+    return true;
+}
+
+bool ValidName(const std::string& name, size_t limit)
+{
+    return !name.empty() && name.size() <= limit &&
+        name.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789_") == std::string::npos;
+}
+
+void MapJump(PPCContext& ctx, uint8_t* base)
+{
+    static const char* path = getenv("LO_DIAG_MAPJUMP_COMMAND_FILE");
+    static unsigned last = 0;
+    static std::chrono::steady_clock::time_point next{};
+    if (!path || !Due(next)) return;
+    std::ifstream input(path);
+    unsigned serial = 0;
+    std::string map;
+    if (!(input >> serial >> map) || serial == last) return;
+    last = serial;
+    if (!ValidName(map, 32)) { LOG_INFO("diag mapjump rejected: invalid map name"); return; }
+    const auto engine = PPC_LOAD_U32(0x83315FB4);
+    const auto pendingMap = PPC_LOAD_U32(0x83263E50);
+    if (!ObjectAddress(engine) || pendingMap != 0)
+    {
+        LOG_INFO("diag mapjump rejected: engine={:#x} pending={}", engine, pendingMap);
+        return;
+    }
+    constexpr uint32_t nativeMapText = 0x821573D8;
+    constexpr char16_t expected[] = u"xxx_x_scrw";
+    for (uint32_t i = 0; i < std::size(expected); ++i)
+        if (PPC_LOAD_U16(nativeMapText + i * 2) != expected[i])
+        {
+            LOG_INFO("diag mapjump rejected: native map constant mismatch");
+            return;
+        }
+    void* memory = g_userHeap.Alloc(96);
+    if (!memory) return;
+    const auto descriptor = g_memory.MapVirtual(memory);
+    const auto text = descriptor + 16;
+    for (uint32_t i = 0; i < map.size(); ++i)
+        PPC_STORE_U16(text + i * 2, uint16_t(uint8_t(map[i])));
+    PPC_STORE_U16(text + uint32_t(map.size()) * 2, 0);
+    PPC_STORE_U32(descriptor, text);
+    PPC_STORE_U32(descriptor + 4, uint32_t(map.size() + 1));
+    PPC_STORE_U32(descriptor + 8, uint32_t(map.size() + 1));
+    const PPCContext saved = ctx;
+    LOG_INFO("diag mapjump begin target={} engine={:#x}", map, engine);
+    ctx.r3.u64 = engine;
+    ctx.r4.u64 = descriptor;
+    __imp__sub_82827580(ctx, base);
+    const int32_t result = ctx.r3.s32;
+    ctx = saved;
+    g_userHeap.Free(memory);
+    LOG_INFO("diag mapjump end result={} pending={}", result, PPC_LOAD_U32(0x83263E50));
+}
+
+// Package cache lookup (vtable +8 of 0x83302A18, as sub_8237D258 calls it).
+void Probe(PPCContext& ctx, uint8_t* base)
+{
+    static const char* path = getenv("LO_DIAG_PROBE_COMMAND_FILE");
+    static unsigned last = 0;
+    static std::chrono::steady_clock::time_point next{};
+    if (!path || !Due(next)) return;
+    std::ifstream input(path);
+    unsigned serial = 0;
+    if (!(input >> serial) || serial == last) return;
+    last = serial;
+    const uint32_t cache = PPC_LOAD_U32(0x83302A18);
+    if (!ObjectAddress(cache)) { LOG_INFO("diag probe rejected: cache={:#x}", cache); return; }
+    auto* find = g_memory.FindFunction(PPC_LOAD_U32(PPC_LOAD_U32(cache) + 8));
+    void* scratch = g_userHeap.Alloc(256);
+    if (!find || !scratch) return;
+    const uint32_t text = g_memory.MapVirtual(scratch), out = text + 160;
+    unsigned total = 0, found = 0;
+    std::string name;
+    while (input >> name)
+    {
+        if (!ValidName(name, 64)) continue;
+        for (uint32_t i = 0; i < name.size(); ++i)
+            PPC_STORE_U16(text + i * 2, uint16_t(uint8_t(name[i])));
+        PPC_STORE_U16(text + uint32_t(name.size()) * 2, 0);
+        PPC_STORE_U32(out, 0);
+        PPC_STORE_U32(out + 4, 0);
+        PPC_STORE_U32(out + 8, 0);
+        const PPCContext saved = ctx;
+        ctx.r3.u64 = cache;
+        ctx.r4.u64 = text;
+        ctx.r5.u64 = 0;
+        ctx.r6.u64 = out;
+        ctx.r7.u64 = 0;
+        find(ctx, base);
+        const bool resolved = ctx.r3.u32 != 0;
+        if (PPC_LOAD_U32(out))
+        {
+            ctx.r3.u64 = out;
+            sub_82298938(ctx, base);
+        }
+        ctx = saved;
+        LOG_INFO("diag probe package={} found={}", name, resolved ? 1 : 0);
+        ++total;
+        found += resolved;
+    }
+    g_userHeap.Free(scratch);
+    LOG_INFO("diag probe done total={} found={}", total, found);
+}
+}
+
+void DiagTourTick(PPCContext& ctx, uint8_t* base)
+{
+    MapJump(ctx, base);
+    Probe(ctx, base);
+}
+
+// The LoDiscRuntimeTest probe's original disc request 82821E90 on the
+// manager at 0x832640B0, from its own update.
+PPC_FUNC(sub_82320428)
+{
+    const uint32_t manager = ctx.r3.u32;
+    __imp__sub_82320428(ctx, base);
+    static const char* path = getenv("LO_DIAG_DISC_COMMAND_FILE");
+    static unsigned last = 0, tick = 0, pending = 0;
+    if (!path) return;
+    if (pending && PPC_LOAD_U16(manager + 8) == pending && !PPC_LOAD_U32(manager + 4) && !PPC_LOAD_U32(manager + 24))
+    {
+        LOG_INFO("diag disc completed disc={}", pending);
+        pending = 0;
+    }
+    if (++tick % 30 || pending) return;
+    unsigned serial = 0, disc = 0;
+    std::ifstream input(path);
+    if (!(input >> serial >> disc) || serial == last || disc < 1 || disc > 4) return;
+    last = serial;
+    LOG_INFO("diag disc request disc={} current={} manager={:#x}", disc, PPC_LOAD_U16(manager + 8), manager);
+    const PPCContext saved = ctx;
+    ctx.r3.u64 = manager;
+    ctx.r4.u64 = disc;
+    sub_82821E90(ctx, base);
+    const int32_t result = ctx.r3.s32;
+    ctx = saved;
+    pending = disc;
+    LOG_INFO("diag disc request returned {}", result);
+}
