+    // Test-only device attachment: no SDL window, guest process, profile or saves.
+    // The tests still execute this translation unit's real native submit/wait code.
+    void InstallFixtureGpu(std::unique_ptr<plume::RenderInterface> api,
+        std::unique_ptr<plume::RenderDevice> device, std::unique_ptr<plume::RenderCommandQueue> queue) {
+        assert(!g_device && !g_queue && !g_interface);
+        g_interface = std::move(api); g_device = std::move(device); g_queue = std::move(queue);
+        g_submissionState = {}; g_vulkan = true; g_available = true;
+    }
+    void RemoveFixtureGpu() {
+        DrainGpuForShutdown(); g_available = false;
