#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D sourceColor;
layout(set = 0, binding = 1) uniform sampler2D sourceDepth;
layout(set = 0, binding = 2) uniform sampler2D sceneContribution;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D linearColor;
layout(set = 0, binding = 4, r32f) uniform writeonly image2D canonicalDepth;
layout(set = 0, binding = 5, r32f) uniform writeonly image2D reactiveMask;

layout(push_constant) uniform Parameters {
    ivec2 colorOrigin;
    ivec2 depthOrigin;
    ivec2 size;
    float depthScale;
    float depthBias;
    ivec2 maskOrigin;
    uint maskEnabled;
    float reactiveMax;
} params;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, params.size))) return;
    vec4 encoded = texelFetch(sourceColor, p + params.colorOrigin, 0);
    float rawDepth = texelFetch(sourceDepth, p + params.depthOrigin, 0).r;
    imageStore(linearColor, p, vec4(pow(max(encoded.rgb, vec3(0.0)), vec3(2.2)), encoded.a));
    float canonical = isnan(rawDepth) || isinf(rawDepth) ? 0.0 :
        clamp(rawDepth * params.depthScale + params.depthBias, 0.0, 1.0);
    imageStore(canonicalDepth, p, vec4(canonical));
    if (params.maskEnabled != 0) {
        float m = texelFetch(sceneContribution, p + params.maskOrigin, 0).r;
        imageStore(reactiveMask, p, vec4(min(params.reactiveMax, clamp(m, 0.0, 1.0))));
    }
}
